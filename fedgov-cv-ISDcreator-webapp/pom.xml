<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>fedgov-cv-ISDcreator-webapp</artifactId>
	<name>Connected Vehicle Intersection Builder WebApp</name>
	<packaging>war</packaging>
	<parent>
		<groupId>gov.usdot</groupId>
		<artifactId>fedgov-cv-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../fedgov-cv-parent/pom.xml</relativePath>
	</parent>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>1.8</java.version>
	</properties>	
	<dependencies>
		<dependency>
			<groupId>gov.usdot</groupId>
			<artifactId>fedgov-cv-message-builder</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>org.jasig.cas.client</groupId>
			<artifactId>cas-client-core</artifactId>
			<scope>runtime</scope>
			<type>jar</type>
		</dependency>
	</dependencies>
	<dependencyManagement>
		<dependencies>
			<!-- Jetty 12 core artifacts (groupId unchanged) -->
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-util</artifactId>
				<version>12.0.21</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-io</artifactId>
				<version>12.0.21</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-http</artifactId>
				<version>12.0.21</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-server</artifactId>
				<version>12.0.21</version>
			</dependency>
			<!-- Jetty 12 ee8 servlet artifacts (moved to org.eclipse.jetty.ee8 groupId) -->
			<dependency>
				<groupId>org.eclipse.jetty.ee8</groupId>
				<artifactId>jetty-ee8-servlet</artifactId>
				<version>12.0.21</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.ee8</groupId>
				<artifactId>jetty-ee8-servlets</artifactId>
				<version>12.0.21</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<finalName>isd</finalName>
		<plugins>
			<plugin>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
					<ignoreWebxml>false</ignoreWebxml>
					<webXml>src/main/webapp/WEB-INF/web.xml</webXml>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<description>A Webapp providing tools to access the Connected Vehicle Warehouses</description>
</project>
